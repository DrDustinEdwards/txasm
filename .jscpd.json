{
  "path": ["app", "workers", "scripts", "tests"],
  "format": ["typescript", "tsx", "css"],
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/.react-router/**",
    "**/*.d.ts",
    "scripts/seed-data/**",
    "scripts/_generated/**",
    "**/*.md"
  ],
  "minLines": 8,
  "minTokens": 70,
  "reporters": ["console"],
  "gitignore": true
}
