{
  "path": [
    "app",
    "workers",
    "scripts",
    "tests",
    "drizzle.config.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "react-router.config.ts",
    "vite.config.ts"
  ],
  "format": ["typescript", "tsx", "css"],
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/.react-router/**",
    "**/*.d.ts",
    "scripts/seed-data/**",
    "scripts/_generated/**",
    "**/*.md"
  ],
  "minLines": 8,
  "minTokens": 70,
  "reporters": ["console"],
  "gitignore": true
}
