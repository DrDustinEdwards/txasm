{
  "name": "txasm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-headers.mjs && react-router build",
    "dev": "react-router dev",
    "typecheck": "devkit-bootstrap --types-only && react-router typegen && tsc -b",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "devkit-bootstrap --types-only",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply txasm --local",
    "db:migrate:prod": "wrangler d1 migrations apply txasm --remote",
    "seed:abstract-book": "tsx scripts/seed-abstract-book.ts",
    "import:meeting": "tsx scripts/import-meeting.ts",
    "import:awards": "tsx scripts/import-awards.ts",
    "load:documents": "tsx scripts/load-documents.ts",
    "postinstall": "devkit-bootstrap"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.12",
    "@cloudflare/puppeteer": "1.1.0",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.22.1",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.7.0",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.17.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.48.1",
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.12",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.54.0",
    "drizzle-orm": "0.45.2",
    "hast-util-to-string": "3.0.1",
    "isbot": "5.1.44",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.5.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.20.9",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "10.6.0",
    "miniflare": "4.20260730.0",
    "tsx": "4.22.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0",
    "wrangler": "^4.152.0"
  }
}
