{
  "name": "txasm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run headers && react-router build",
    "headers": "site-runtime-headers --site txasm --out public/_headers --header \"tdm-reservation: 1\"",
    "dev": "react-router dev",
    "typecheck": "devkit-bootstrap --types-only && react-router typegen && tsc -b",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "test": "tsx --test tests/*.test.ts",
    "check:console": "devkit-console",
    "check:migrations": "devkit-migrations drizzle",
    "check:session": "site-runtime-session-check app workers",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "devkit-bootstrap --types-only",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply txasm --local",
    "db:migrate:prod": "wrangler d1 migrations apply txasm --remote",
    "seed:abstract-book": "tsx scripts/seed-abstract-book.ts",
    "import:meeting": "tsx scripts/import-meeting.ts",
    "import:awards": "tsx scripts/import-awards.ts",
    "load:documents": "tsx scripts/load-documents.ts",
    "postinstall": "devkit-bootstrap",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.17",
    "@cloudflare/puppeteer": "1.4.0",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.43.0",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.16.0",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.36.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.115.1",
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.18",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.89.0",
    "drizzle-orm": "0.45.4",
    "hast-util-to-string": "3.0.1",
    "isbot": "5.2.2",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.27.0",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "^4.152.0"
  }
}
