{
  "name": "txasm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run headers && react-router build",
    "headers": "site-runtime-headers --site txasm --out public/_headers --header \"tdm-reservation: 1\"",
    "dev": "react-router dev",
    "typecheck": "devkit-bootstrap --types-only && react-router typegen && tsc -b",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "test": "tsx --test tests/*.test.ts",
    "check:console": "devkit-console",
    "check:migrations": "devkit-migrations drizzle",
    "check:session": "site-runtime-session-check app workers",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "devkit-bootstrap --types-only",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply txasm --local",
    "db:migrate:prod": "wrangler d1 migrations apply txasm --remote",
    "seed:abstract-book": "tsx scripts/seed-abstract-book.ts",
    "import:meeting": "tsx scripts/import-meeting.ts",
    "import:awards": "tsx scripts/import-awards.ts",
    "load:documents": "tsx scripts/load-documents.ts",
    "postinstall": "devkit-bootstrap",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "1.7.27",
    "@cloudflare/puppeteer": "2.0.1",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.63.14",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.16.3",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.48.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.173.13",
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.27",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.164.7",
    "drizzle-orm": "0.45.4",
    "hast-util-to-mdast": "10.1.3",
    "hast-util-to-string": "3.0.1",
    "hastscript": "9.0.3",
    "htmlparser2": "12.0.0",
    "isbot": "5.2.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.3",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.56.0",
    "@react-router/dev": "8.5.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.164.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "miniflare": {
      "undici": "7.30.2",
      "sharp": "0.35.5"
    }
  }
}
