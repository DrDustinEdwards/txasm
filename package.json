{
  "name": "txasm",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply txasm --local",
    "db:migrate:prod": "wrangler d1 migrations apply txasm --remote",
    "import:meeting": "tsx scripts/import-meeting.ts",
    "import:awards": "tsx scripts/import-awards.ts",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "better-auth": "^1.6.22",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.3",
    "wrangler": "^4.105.0"
  }
}
