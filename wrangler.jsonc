{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "txasm",
	"main": "./workers/app.ts",
	// No newer than the workerd that @cloudflare/vite-plugin bundles supports, or `npm run dev` refuses to start.
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat"],
	// Keep dashboard-set secrets (BETTER_AUTH_SECRET, BETTER_AUTH_URL, ADMIN_EMAILS) from
	// being wiped on deploy.
	"keep_vars": true,
	// Logs and traces, with the sampling rate stated. A low-traffic site can keep
	// every log; traces are sampled to stay inside the plan's event budget.
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
		"traces": { "enabled": true, "head_sampling_rate": 0.1 }
	},
	"upload_source_maps": true,
	// The public pages' edge cache (workers/app.ts, site-runtime ./edge-cache). The default export is the GATEWAY,
	// cache disabled, so it runs on every request: writes, Carrel's API, signed-in and private pages and any request
	// with a cookie answer there. It calls the Renderer through ctx.exports with the path as the cache key, and the
	// Renderer's responses are stored when a route marks them shared. Admin and Carrel writes purge the "pages" tag.
	// No `cross_version_cache`, so the Worker version stays in the key and every deploy starts cold.
	"cache": { "enabled": true },
	"exports": {
		"default": { "type": "worker", "cache": { "enabled": false } },
		"Renderer": { "type": "worker", "cache": { "enabled": true } }
	},
	// Non-secret email config. EMAIL_ENABLED stays off until cutover; flipping it
	// on together with the SEND_EMAIL binding below makes transactional email live.
	"vars": {
		"EMAIL_ENABLED": "false",
		"EMAIL_FROM": "no-reply@txasm.org",
		"EMAIL_FROM_NAME": "TXASM"
	},
	// Native bindings, reached only via context.cloudflare.env in loaders/actions.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "txasm",
			"database_id": "278762e5-7319-4786-946b-4dff49b46d32",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{ "binding": "UPLOADS", "bucket_name": "txasm-uploads" },
		{ "binding": "BOOKS", "bucket_name": "txasm-books" }
	],
	// Rate limit for Carrel's site API (app/lib/carrel). namespace_id must be unique to this site:
	// sites in one account that share one share counters (germomics 7301, foxing 1104).
	"ratelimits": [
		{ "name": "CARREL_RATE_LIMIT", "namespace_id": "7401", "simple": { "limit": 120, "period": 60 } },
		// CSP violation reports (/csp-report), per address. Loose, because a page tripping ten rules sends ten.
		{ "name": "CSP_REPORT_RATE_LIMIT", "namespace_id": "7402", "simple": { "limit": 60, "period": 60 } }
	],
	// site-runtime's exact rate limiter (./rate-limit), exported from workers/app.ts: the sign-in's per-address
	// limits (app/lib/auth.server.ts, emailLimiter). One SQLite-backed instance per key.
	"durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
	// Browser Rendering for the abstract book PDF. Generate in a batch job, not a
	// user request, to stay inside the quota. May want the paid Workers plan for headroom.
	"browser": { "binding": "BROWSER" },
	// The media library (app/lib/carrel/media-adapter.server.ts), whose files are in UPLOADS under media/.
	// Images serves each page picture's sizes from its one original (/media/<key>?w=, site-runtime ./image)
	// and makes the edits an editor asks for (a turn, a mirror, the shrink at upload). Without it the route
	// serves the original and says so in x-image. Account-scoped, no id.
	"images": { "binding": "IMAGES" },
	// Workers AI, for the library's suggested tags and alt text: one call when an editor asks in Carrel,
	// never on a visitor's request, never applied unasked. Through AI Gateway when the dashboard variable
	// AI_GATEWAY_BASE_URL names one (kept by keep_vars, so the account id stays out of this public file).
	"ai": { "binding": "AI" },
	// Cloudflare Email Service (Email Sending). Enabled at cutover once txasm.org
	// is on Cloudflare DNS and the domain is onboarded for Email Sending (SPF,
	// DKIM, bounce records). Kept commented so deploys keep working now without it;
	// uncomment and set EMAIL_ENABLED to true to go live.
	// "send_email": [{ "name": "SEND_EMAIL" }],
	// Deadline jobs and reminders. 13:00 UTC daily; tune per edition windows.
	"triggers": { "crons": ["0 13 * * *"] }
}
