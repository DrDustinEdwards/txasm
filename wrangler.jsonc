{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "txasm",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-06-21",
	"compatibility_flags": ["nodejs_compat"],
	// Keep dashboard-set secrets (BETTER_AUTH_SECRET, BETTER_AUTH_URL, ADMIN_EMAILS) from
	// being wiped on deploy.
	"keep_vars": true,
	// Logs and traces, with the sampling rate stated. A low-traffic site can keep
	// every log; traces are sampled to stay inside the plan's event budget.
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
		"traces": { "enabled": true, "head_sampling_rate": 0.1 }
	},
	"upload_source_maps": true,
	// Non-secret email config. EMAIL_ENABLED stays off until cutover; flipping it
	// on together with the SEND_EMAIL binding below makes transactional email live.
	"vars": {
		"EMAIL_ENABLED": "false",
		"EMAIL_FROM": "no-reply@txasm.org",
		"EMAIL_FROM_NAME": "TXASM"
	},
	// Native bindings, reached only via context.cloudflare.env in loaders/actions.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "txasm",
			"database_id": "278762e5-7319-4786-946b-4dff49b46d32",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{ "binding": "UPLOADS", "bucket_name": "txasm-uploads" },
		{ "binding": "BOOKS", "bucket_name": "txasm-books" }
	],
	"kv_namespaces": [
		{ "binding": "APP_KV", "id": "b58a10950cf54fb6a54ca8808123d211" }
	],
	// Browser Rendering for the abstract book PDF. Generate in a batch job, not a
	// user request, to stay inside the quota. May want the paid Workers plan for headroom.
	"browser": { "binding": "BROWSER" },
	// Cloudflare Email Service (Email Sending). Enabled at cutover once txasm.org
	// is on Cloudflare DNS and the domain is onboarded for Email Sending (SPF,
	// DKIM, bounce records). Kept commented so deploys keep working now without it;
	// uncomment and set EMAIL_ENABLED to true to go live.
	// "send_email": [{ "name": "SEND_EMAIL" }],
	// Deadline jobs and reminders. 13:00 UTC daily; tune per edition windows.
	"triggers": { "crons": ["0 13 * * *"] }
}
