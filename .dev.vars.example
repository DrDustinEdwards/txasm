# Copy to .dev.vars for local dev. Real values go in wrangler secrets, never in git.
# Generate a fresh secret: openssl rand -base64 32

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Cloudflare Email Service (Email Sending). Goes live at cutover when txasm.org
# is on Cloudflare DNS and the domain is onboarded (SPF, DKIM, bounce records).
# Until then email is dormant: the helper logs messages instead of sending.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@txasm.org
EMAIL_FROM_NAME=TXASM

# Platform admins. ADMIN_EMAILS is a comma-separated allowlist, read on every
# request: an account whose email is on it is a platform admin, and one taken off
# it is not. ADMIN_EMAIL is the older single-value form, still honored when
# ADMIN_EMAILS is not set.
ADMIN_EMAILS=
ADMIN_EMAIL=

# Cloudflare Turnstile on the sign-in link. The check is on only when both are set.
# Cloudflare's test pair always passes: 1x00000000000000000000AA and
# 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Platform admins sign in through Cloudflare Access in production (app/lib/access.server.ts);
# "1" lets localhost in.
ACCESS_DEV_BYPASS="1"
